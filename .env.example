# ============================================================
#  Online Shopping bot — muhit sozlamalari
#  Ushbu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring.
#  .env hech qachon git ga qo'shilmaydi!
# ============================================================

# --- majburiy ---
# @BotFather dan olingan token
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Adminlarning Telegram ID lari (vergul bilan). @userinfobot orqali bilib oling.
ADMIN_IDS=123456789

# --- ma'lumotlar bazasi ---
DATABASE_URL=sqlite+aiosqlite:///data/shop.db
TIMEZONE=Asia/Tashkent
SHOP_CURRENCY=so'm

# --- to'lov ---
# 1 Telegram Star qancha so'mga teng (Telegram Stars kalkulyatsiyasi uchun)
STARS_RATE=250

# --- Telegram Mini App (ixtiyoriy) ---
# HTTPS manzil (masalan Cloudflare Tunnel / VPS domeni). Bo'sh bo'lsa Mini App o'chadi.
WEBAPP_URL=
WEBAPP_ENABLED=false
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080

# --- obuna talabi (ixtiyoriy) ---
# Kanaldan ID (masalan -1001234567890). Bo'sh bo'lsa talab qo'yilmaydi.
REQUIRED_CHANNEL_ID=
REQUIRED_CHANNEL_URL=

# --- qo'llab-quvvatlash ---
SUPPORT_USERNAME=

# --- himoya / limitlar ---
THROTTLE_LIMIT=8
THROTTLE_WINDOW=2

# --- adminlarga buyurtma xabarlari uchun guruh (ixtiyoriy) ---
ADMIN_LOG_CHAT_ID=

# --- webhook (ixtiyoriy, polling o'rniga) ---
USE_WEBHOOK=false
WEBHOOK_URL=
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=

LOG_LEVEL=INFO
